{
  "spec_name": "RoutingDecision",
  "version": "1.0",
  "json_schema": {
    "$defs": {
      "ExtractedEntities": {
        "additionalProperties": false,
        "properties": {
          "order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "訂單編號，例如 ORD-20261103-0042",
            "title": "Order Id"
          },
          "product": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "商品名稱或型號",
            "title": "Product"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "金額（新台幣）",
            "title": "Amount"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "系統錯誤代碼，例如 E-1024",
            "title": "Error Code"
          }
        },
        "title": "ExtractedEntities",
        "type": "object"
      },
      "ImageAnalysis": {
        "additionalProperties": false,
        "properties": {
          "has_image": {
            "description": "本輪是否附圖",
            "title": "Has Image",
            "type": "boolean"
          },
          "image_type": {
            "$ref": "#/$defs/ImageType",
            "description": "圖片類型"
          },
          "description": {
            "description": "一句話描述圖片中與客服相關的內容",
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "has_image",
          "image_type",
          "description"
        ],
        "title": "ImageAnalysis",
        "type": "object"
      },
      "ImageType": {
        "enum": [
          "none",
          "product_damage",
          "receipt_invoice",
          "error_screenshot",
          "package_label",
          "other"
        ],
        "title": "ImageType",
        "type": "string"
      },
      "SafetyFlag": {
        "enum": [
          "safe",
          "prompt_injection",
          "jailbreak",
          "image_injection",
          "pii_exposure",
          "harmful"
        ],
        "title": "SafetyFlag",
        "type": "string"
      },
      "Sentiment": {
        "enum": [
          "positive",
          "neutral",
          "negative",
          "angry"
        ],
        "title": "Sentiment",
        "type": "string"
      },
      "Urgency": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Urgency",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "分流節點的結構化輸出。",
    "properties": {
      "department": {
        "description": "應轉接的部門 ID",
        "enum": [
          "billing",
          "technical_support",
          "logistics",
          "returns_refunds",
          "account_security",
          "sales",
          "human_agent"
        ],
        "title": "Department",
        "type": "string"
      },
      "intent": {
        "description": "使用者意圖，snake_case，例如 refund_damaged_item",
        "title": "Intent",
        "type": "string"
      },
      "urgency": {
        "$ref": "#/$defs/Urgency"
      },
      "sentiment": {
        "$ref": "#/$defs/Sentiment"
      },
      "requires_human": {
        "description": "是否需要真人介入",
        "title": "Requires Human",
        "type": "boolean"
      },
      "is_off_topic": {
        "description": "本輪是否與客服業務無關",
        "title": "Is Off Topic",
        "type": "boolean"
      },
      "safety_flag": {
        "$ref": "#/$defs/SafetyFlag"
      },
      "confidence": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Confidence",
        "type": "number"
      },
      "entities": {
        "$ref": "#/$defs/ExtractedEntities"
      },
      "image_analysis": {
        "$ref": "#/$defs/ImageAnalysis"
      },
      "context_summary": {
        "description": "整合多輪脈絡後的一句話摘要",
        "title": "Context Summary",
        "type": "string"
      }
    },
    "required": [
      "department",
      "intent",
      "urgency",
      "sentiment",
      "requires_human",
      "is_off_topic",
      "safety_flag",
      "confidence",
      "entities",
      "image_analysis",
      "context_summary"
    ],
    "title": "RoutingDecision",
    "type": "object"
  },
  "departments": {
    "billing": {
      "name_zh": "帳務與付款",
