      "required_slots": [
        "order_id"
      ]
    },
    "technical_support": {
      "name_zh": "技術支援",
      "description": "App/網站錯誤、登入以外的系統故障、裝置連線、錯誤代碼",
      "required_slots": [
        "error_code"
      ]
    },
    "logistics": {
      "name_zh": "物流配送",
      "description": "出貨進度、配送延遲、包裹遺失、改地址",
      "required_slots": [
        "order_id"
      ]
    },
    "returns_refunds": {
      "name_zh": "退換貨",
      "description": "商品瑕疵、破損、退貨、換貨、鑑賞期",
      "required_slots": [
        "order_id",
        "product"
      ]
    },
    "account_security": {
      "name_zh": "帳號安全",
      "description": "盜用、異常登入、密碼重設、雙因素驗證",
      "required_slots": []
    },
    "sales": {
      "name_zh": "售前諮詢",
      "description": "商品規格、價格、優惠、庫存、方案比較",
      "required_slots": []
    },
    "human_agent": {
      "name_zh": "真人客服",
      "description": "使用者明確要求真人、高度不滿、或機器無法處理之情境",
      "required_slots": []
    }
  },
  "example_input": {
    "history": [
      {
        "role": "user",
        "content": "請問 ORD-20261103-0042 什麼時候會到？"
      },
      {
        "role": "assistant",
        "content": "您的包裹已於今日送達超商。"
      }
    ],
    "user_message": "拿到了，但充電盒整個裂開，我要退貨，照片給你看",
    "image": "<product_damage.png>"
  },
  "example_output": {
    "department": "returns_refunds",
    "intent": "return_damaged_item",
    "urgency": "high",
    "sentiment": "negative",
    "requires_human": false,
    "is_off_topic": false,
    "safety_flag": "safe",
    "confidence": 0.93,
    "entities": {
      "order_id": "ORD-20261103-0042",
      "product": "SoundMax 藍牙耳機 X2",
      "amount": 2490.0,
      "error_code": null
    },
    "image_analysis": {
      "has_image": true,
      "image_type": "product_damage",
      "description": "耳機充電盒外殼右側明顯裂痕，包裝盒角落凹陷"
    },
    "context_summary": "使用者上一輪詢問到貨時間，本輪表示收到的耳機充電盒破裂，要求退貨並附上照片。"
  }
}